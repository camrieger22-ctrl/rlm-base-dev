<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Ramp Builder</masterLabel>
    <description>Full-page Ramp Builder for a group ramp schedule and products-by-segment grid.</description>
    <targets>
        <target>lightning__UrlAddressable</target>
        <target>lightning__RecordPage</target>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="recordId" type="String" label="Quote Id" role="inputOnly" />
            <property name="planJson" type="String" label="Plan JSON" role="outputOnly" />
            <property name="saveRequested" type="Boolean" label="Save requested" role="outputOnly" />
            <property name="cancelRequested" type="Boolean" label="Cancel requested" role="outputOnly" />
        </targetConfig>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Quote</object>
            </objects>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
