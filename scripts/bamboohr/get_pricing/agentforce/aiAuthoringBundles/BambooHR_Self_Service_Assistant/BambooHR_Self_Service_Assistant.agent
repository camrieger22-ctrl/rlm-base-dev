subagent get_a_price_or_quote:
    label: "Get a price or quote"
    description: "Help new buyers choose plan/add-ons/headcount/term, run Pricing API estimates (no Quote), then create a Revenue Cloud Quote after collecting company and work email. Return the branded summary URL. Do not invent PEPM. #DisableURLRedaction#"

    reasoning:
        instructions: ->
            | Help a new buyer get a PEPM estimate and optionally a Quote.
              Collect: plan (Core or Pro → BAMBOO-CORE / BAMBOO-PRO), headcount, start date, term (12/24/36).
              Acquisition Quotes have no add-on SKUs — leave addonSkusCsv empty. Time & Attendance is Licenses-only.
              Elite and Payroll are sales — never Quote BAMBOO-ELITE or BAMBOO-ADD-PAYROLL; those buyers belong on Qualify → Handoff.
              Call Estimate_Get_Pricing for PEPM — never invent numbers; speak the Summary output (use its PEPM and monthly).
              Guests may estimate without an account.
              Do NOT call Create_Get_Pricing_Quote unless qualifyCommitted is true OR lastQuoteId / pageQuoteId is already set.
              If the Create Quote action returns commitRequired / “Create your self-serve account”, transition to Qualify and commit — do not retry Place or invent a Quote.
              If qualifyCommitted is empty AND lastQuoteId and pageQuoteId are empty, transition to Qualify to lookup + commit first.
              If qualifyLookupStatus is existingCustomer, transition to Change my licenses. If salesWorking, do not Create Quote.
              After Quote create: speak Summary PEPM/monthly, then paste the full https quoteUrl on its own line exactly as returned. Never omit the URL or paraphrase it away.
              Call Get Page Context first (pass current Quote/Account/session/committed) so sticky Ids are not wiped.
              Pass previewQuoteId=lastQuoteId and pageQuoteId so the BFF updates the same Draft. Do not create a second Quote for the same buyer.
              Place is Purchase — recite totals then Place Get Pricing Order only after confirmation.
              “Where am I?” / “what page is this” / “what’s next on this page” → go_to_help_with_this_page. Do not invent a product description.
        actions:
            Get_Page_Context: @actions.Get_Page_Context
                with messagingSessionId=@variables.RoutableId
                with currentQuoteId=@variables.lastQuoteId
                with currentAccountId=@variables.activeAccountId
                with currentQualifySessionId=@variables.qualifySessionId
                with currentCommitted=@variables.qualifyCommitted
                set @variables.lastQuoteId = @outputs.quoteId
                set @variables.activeAccountId = @outputs.accountId
                set @variables.qualifySessionId = @outputs.qualifySessionId
                set @variables.lastQuoteUrl = @outputs.quoteUrl
                set @variables.qualifyCommitted = @outputs.qualifyCommitted
            Estimate_Get_Pricing: @actions.Estimate_Get_Pricing
                with headcount=...
                with country=...
                with planSku=...
                with addonSkusCsv=...
                with freeTrial=...
                with startDate=...
                with termMonths=...
            Create_Get_Pricing_Quote: @actions.Create_Get_Pricing_Quote
                with headcount=...
                with country=...
                with planSku=...
                with addonSkusCsv=...
                with freeTrial=...
                with startDate=...
                with termMonths=...
                with company=...
                with email=...
                with firstName=...
                with lastName=...
                with previewQuoteId=@variables.lastQuoteId
                with pageQuoteId=@variables.pageQuoteId
                with accountId=@variables.activeAccountId
                set @variables.lastQuoteUrl = @outputs.quoteUrl
                set @variables.lastQuoteId = @outputs.quoteId
                set @variables.activeAccountId = @outputs.accountId
                set @variables.lastStartDate = @outputs.startDate
                set @variables.lastPlanSku = @outputs.planSku
                set @variables.lastHeadcount = @outputs.headcountText
                set @variables.lastTermMonths = @outputs.termMonthsText
                set @variables.lastMonthlyTotal = @outputs.monthlyTotalText
            go_to_qualify: @utils.transition to @subagent.qualify
            go_to_purchase: @utils.transition to @subagent.purchase
            go_to_change_my_licenses: @utils.transition to @subagent.change_my_licenses
            go_to_help_with_this_page: @utils.transition to @subagent.help_with_this_page

    actions:
        Get_Page_Context:
            description: "Read the buyer's current self-serve wizard beat, employee count, surface, and sales bounce from the Messaging Session. Call before answering any orientation question."
            label: "Get Page Context"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Checking where you are…"
            target: "apex://RLM_BambooAgentGetPageContext"
            inputs:
                messagingSessionId: string
                    description: "Messaging Session Id. Always pass the RoutableId variable."
                    label: "Messaging Session Id"
                    is_required: True
                    is_user_input: False
                currentQuoteId: string
                    description: "lastQuoteId so a blank page does not wipe session."
                    label: "Current Quote Id"
                    is_required: False
                    is_user_input: False
                currentAccountId: string
                    description: "activeAccountId so a blank page does not wipe session."
                    label: "Current Account Id"
                    is_required: False
                    is_user_input: False
                currentQualifySessionId: string
                    description: "qualifySessionId so a blank page does not wipe session."
                    label: "Current qualify session Id"
                    is_required: False
                    is_user_input: False
                currentCommitted: string
                    description: "qualifyCommitted so a blank page does not wipe it."
                    label: "Current committed"
                    is_required: False
                    is_user_input: False
            outputs:
                isSuccess: boolean
                    description: "Success flag."
                    label: "Is Success"
                    is_displayable: False
                    filter_from_agent: False
                errorMessage: string
                    description: "Error if the session could not be read."
                    label: "Error Message"
                    is_displayable: False
                    filter_from_agent: False
                summary: string
                    description: "Page context in one sentence — state this beat to the buyer."
                    label: "Summary"
                    is_displayable: True
                    filter_from_agent: False
                hasContext: boolean
                    description: "False when the buyer opened chat with no wizard context."
                    label: "Has Context"
                    is_displayable: False
                    filter_from_agent: False
                qualifyStep: string
                    description: "Wizard beat 1-5, blank when unknown."
                    label: "Qualify Step"
                    is_displayable: False
                    filter_from_agent: False
                qualifyStepLabel: string
                    description: "Plain-language name of the current beat."
                    label: "Qualify Step Label"
                    is_displayable: False
                    filter_from_agent: False
                bounceType: string
                    description: "size, geo, payroll, elite, or blank."
                    label: "Bounce Type"
                    is_displayable: False
                    filter_from_agent: False
                headcount: string
                    description: "Employee count the buyer entered."
                    label: "Headcount"
                    is_displayable: False
                    filter_from_agent: False
                page: string
                    description: "get-pricing, quote, account, or activate."
                    label: "Page"
                    is_displayable: False
                    filter_from_agent: False
                accountId: string
