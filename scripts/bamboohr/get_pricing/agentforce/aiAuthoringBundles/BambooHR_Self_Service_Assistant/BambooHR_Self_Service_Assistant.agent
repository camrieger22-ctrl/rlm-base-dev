subagent purchase:
    label: "Purchase"
    description: "Place the Get Pricing Quote on this page. Call Get Page Context, speak placeRecitation, then Place in the same turn. Never ask the buyer to type yes. Never take a card number. #DisableURLRedaction#"

    reasoning:
        instructions: ->
            | Place the Get Pricing Draft Quote that is already on this page or in session.
              pageQuoteId / lastQuoteId mean you already have the Quote — do not interview the buyer.
              REQUIRED sequence this turn (one turn, no waiting for chat yes):
              1) Call Get_Page_Context.
              2) Speak the placeRecitation output VERBATIM as your only user-visible text (if blank, speak summary).
              3) In the SAME turn, call Place_Get_Pricing_Order with quoteId=lastQuoteId or pageQuoteId.
              The buyer's utterance “place my order” is the confirmation. Do NOT wait for another message.
              Banned user-visible phrases: “reply yes”, “please reply”, “would you like me to go ahead”, “go ahead with this”, “just to make sure”.
              If both lastQuoteId and pageQuoteId are empty after Get_Page_Context, transition to Get a price or quote.
              Never collect a card number. Paste paymentUrl on its own line when returned.
              If paymentUrl is empty after Place, or the buyer asks for Pay Now / Collect Payment, call Collect_Payment this turn.
              Do not call Collect_Payment when lastPaymentUrl is already a https Pay Now URL.
              If Place fails, speak the error — do not retry blindly.
              “Where am I?” / “what page is this” → go_to_help_with_this_page.
        actions:
            Get_Page_Context: @actions.Get_Page_Context
                with messagingSessionId=@variables.RoutableId
                with currentQuoteId=@variables.lastQuoteId
                with currentAccountId=@variables.activeAccountId
                with currentQualifySessionId=@variables.qualifySessionId
                with currentCommitted=@variables.qualifyCommitted
                set @variables.lastQuoteId = @outputs.quoteId
                set @variables.activeAccountId = @outputs.accountId
                set @variables.qualifySessionId = @outputs.qualifySessionId
                set @variables.lastQuoteUrl = @outputs.quoteUrl
                set @variables.qualifyCommitted = @outputs.qualifyCommitted
                set @variables.lastStartDate = @outputs.startDate
                set @variables.lastMonthlyTotal = @outputs.monthlyTotalText
                set @variables.lastHeadcount = @outputs.headcount
                set @variables.lastPlanSku = @outputs.planLabel
            Place_Get_Pricing_Order: @actions.Place_Get_Pricing_Order
                with quoteId=@variables.lastQuoteId
                with pageQuoteId=@variables.pageQuoteId
                with accountId=@variables.activeAccountId
                set @variables.lastOrderId = @outputs.orderId
                set @variables.lastPaymentUrl = @outputs.paymentUrl
            Collect_Payment: @actions.Collect_Payment
                with orderId=...
                set @variables.lastOrderId = @outputs.orderId
                set @variables.lastPaymentUrl = @outputs.paymentUrl
            go_to_get_a_price_or_quote: @utils.transition to @subagent.get_a_price_or_quote
            go_to_help_with_this_page: @utils.transition to @subagent.help_with_this_page

    actions:
        Get_Page_Context:
            description: "On Place, call first. Returns placeRecitation — speak that verbatim, then Place. Never ask the buyer to type yes."
            label: "Get Page Context"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Loading your quote…"
            target: "apex://RLM_BambooAgentGetPageContext"
            inputs:
                messagingSessionId: string
                    description: "Messaging Session Id. Always pass the RoutableId variable."
                    label: "Messaging Session Id"
                    is_required: True
                    is_user_input: False
                currentQuoteId: string
                    description: "lastQuoteId so a blank page does not wipe session."
                    label: "Current Quote Id"
                    is_required: False
                    is_user_input: False
                currentAccountId: string
                    description: "activeAccountId so a blank page does not wipe session."
                    label: "Current Account Id"
                    is_required: False
                    is_user_input: False
                currentQualifySessionId: string
                    description: "qualifySessionId so a blank page does not wipe session."
                    label: "Current qualify session Id"
                    is_required: False
                    is_user_input: False
                currentCommitted: string
                    description: "qualifyCommitted so a blank page does not wipe it."
                    label: "Current committed"
                    is_required: False
                    is_user_input: False
            outputs:
                isSuccess: boolean
                    description: "Success flag."
                    label: "Is Success"
                    is_displayable: False
                    filter_from_agent: False
                errorMessage: string
                    description: "Error if the session could not be read."
                    label: "Error Message"
                    is_displayable: False
                    filter_from_agent: False
                summary: string
                    description: "Page context in one sentence — state this beat to the buyer."
                    label: "Summary"
                    is_displayable: True
                    filter_from_agent: False
                hasContext: boolean
                    description: "False when the buyer opened chat with no wizard context."
                    label: "Has Context"
                    is_displayable: False
                    filter_from_agent: False
                qualifyStep: string
                    description: "Wizard beat 1-5, blank when unknown."
                    label: "Qualify Step"
                    is_displayable: False
                    filter_from_agent: False
                qualifyStepLabel: string
                    description: "Plain-language name of the current beat."
                    label: "Qualify Step Label"
                    is_displayable: False
                    filter_from_agent: False
                bounceType: string
                    description: "size, geo, payroll, elite, or blank."
                    label: "Bounce Type"
                    is_displayable: False
                    filter_from_agent: False
                headcount: string
                    description: "Employee count the buyer entered."
                    label: "Headcount"
                    is_displayable: False
                    filter_from_agent: False
                page: string
                    description: "get-pricing, quote, account, or activate."
                    label: "Page"
                    is_displayable: False
                    filter_from_agent: False
                accountId: string
                    description: "Account Id from pre-chat when present."
                    label: "Account Id"
                    is_displayable: False
                    filter_from_agent: False
                quoteId: string
                    description: "Quote Id when chat opened on the summary."
                    label: "Quote Id"
                    is_displayable: False
                    filter_from_agent: False
                qualifySessionId: string
                    description: "BFF qualify wizard session Id from pre-chat."
                    label: "Qualify session Id"
                    is_displayable: False
                    filter_from_agent: False
                quoteUrl: string
                    description: "Absolute quote summary URL when a Quote Id is known."
                    label: "Quote URL"
                    is_displayable: True
                    filter_from_agent: False
                qualifyCommitted: string
                    description: "true when a Quote Id is present or the session was already committed."
                    label: "Qualify committed"
                    is_displayable: False
                    filter_from_agent: False
                startDate: string
                    description: "Quote or line start YYYY-MM-DD when a Quote Id is known."
                    label: "Start date"
                    is_displayable: False
                    filter_from_agent: False
                monthlyTotal: number
                    description: "Quote TotalPrice when known."
                    label: "Monthly total"
                    is_displayable: False
                    filter_from_agent: False
                    complex_data_type_name: "lightning__numberType"
                monthlyTotalText: string
                    description: "String form of monthlyTotal for lastMonthlyTotal."
                    label: "Monthly total text"
                    is_displayable: False
                    filter_from_agent: False
                planLabel: string
                    description: "Product name from the Quote line."
                    label: "Plan label"
                    is_displayable: False
                    filter_from_agent: False
                placeRecitation: string
                    description: "Exact sentence Purchase must speak before Place. Speak this verbatim; never invent a yes/no question."
                    label: "Place recitation"
                    is_displayable: True
                    filter_from_agent: False
        Place_Get_Pricing_Order:
            description: "Place the Get Pricing Quote now. Buyer already said place my order — do not ask them to type yes. Returns Order Id and Pay Now URL. Never a card number."
            label: "Place Get Pricing Order"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Placing your order…"
            target: "apex://RLM_BambooAgentPlaceGetPricingOrder"
            inputs:
                quoteId: string
                    description: "Get Pricing Quote Id (lastQuoteId)."
                    label: "Quote Id"
                    is_required: False
                    is_user_input: False
                pageQuoteId: string
                    description: "Quote Id from page context when lastQuoteId is blank."
                    label: "Page Quote Id"
                    is_required: False
                    is_user_input: False
                accountId: string
                    description: "Session Account Id. Place fails if it does not match the Quote."
                    label: "Account Id"
                    is_required: False
                    is_user_input: False
            outputs:
                isSuccess: boolean
                    description: "True when the order was placed."
                    label: "Is Success"
                    is_displayable: False
                    filter_from_agent: False
                errorMessage: string
                    description: "Error if Place failed."
                    label: "Error Message"
                    is_displayable: False
                    filter_from_agent: False
                summary: string
                    description: "Speak this confirmation. Paste paymentUrl on its own line."
                    label: "Summary"
                    is_displayable: True
                    filter_from_agent: False
                orderId: string
                    description: "Salesforce Order Id."
                    label: "Order Id"
                    is_displayable: False
                    filter_from_agent: False
                orderNumber: string
                    description: "Order number."
                    label: "Order Number"
                    is_displayable: False
                    filter_from_agent: False
                paymentUrl: string
                    description: "Pay Now URL. Never a card number."
                    label: "Payment URL"
                    is_displayable: True
                    filter_from_agent: False
                quoteTotal: object
                    description: "Quote TotalPrice echoed for confirmation."
                    label: "Quote Total"
                    is_displayable: False
                    filter_from_agent: False
                    complex_data_type_name: "lightning__numberType"
                startDate: string
                    description: "Quote start date."
                    label: "Start Date"
                    is_displayable: False
                    filter_from_agent: False
                responseJson: string
                    description: "Raw BFF JSON."
                    label: "Response JSON"
                    is_displayable: False
                    filter_from_agent: True

        Collect_Payment:
            description: "Mint or refresh a Pay Now URL for the Order. Never a card number."
            label: "Collect Payment"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Getting Pay Now…"
            target: "apex://RLM_BambooAgentCollectPayment"
            inputs:
                orderId: string
                    description: "Order Id from Place or the buyer. Pass lastOrderId or the 801 Id they typed."
                    label: "Order Id"
                    is_required: False
                    is_user_input: True
                invoiceId: string
                    description: "Invoice Id when known."
                    label: "Invoice Id"
                    is_required: False
                    is_user_input: False
            outputs:
                isSuccess: boolean
                    description: "True when a Pay Now URL is ready."
                    label: "Is Success"
                    is_displayable: False
                    filter_from_agent: False
                errorMessage: string
                    description: "Error if Collect Payment failed."
                    label: "Error Message"
                    is_displayable: False
                    filter_from_agent: False
                summary: string
                    description: "Speak this. Paste paymentUrl on its own line."
                    label: "Summary"
                    is_displayable: True
                    filter_from_agent: False
                paymentUrl: string
                    description: "Pay Now URL. Never a card number."
                    label: "Payment URL"
                    is_displayable: True
                    filter_from_agent: False
                invoiceId: string
                    description: "Invoice Id."
                    label: "Invoice Id"
                    is_displayable: False
                    filter_from_agent: False
                orderId: string
                    description: "Order Id."
                    label: "Order Id"
                    is_displayable: False
                    filter_from_agent: False
                responseJson: string
                    description: "Raw BFF JSON."
                    label: "Response JSON"
                    is_displayable: False
                    filter_from_agent: True

subagent help_with_this_page:
    label: "Help with this page"
    description: "Orient the buyer on the 5-beat qualify wizard, Get Pricing, quote summary, Licenses, or amend. Narrate current qualify beat and explain bounces from page context. Steer Place order to the on-page CTA. #DisableURLRedaction#"

    reasoning:
        instructions: ->
            | Orient the buyer ONLY from Get Page Context — never from general knowledge.
              On EVERY “where am I?”, “what’s next?”, or page-orientation turn, call Get_Page_Context first.
              Your first sentence MUST be the summary output (or a close paraphrase that keeps page, beat, headcount, and Account Id).
              On page=account say “Licenses & billing” and the Account Id from the summary. Never say generic “account settings”.
              When hasContext is true, never ask what they see. Only when hasContext is false may you ask — and then tell them to close chat, finish the page, and reopen so hidden context can stamp. Never invent a generic self-serve brochure.
              On get-pricing, wizard beats are: 1 size → 2 geo → 3 needs → 4 role → 5 create account.
              If a bounce is active, explain why they talk to a person (Payroll, Elite,
              25+ employees, outside US/CA, or sales already working) — do not invent PEPM
              and do not override UI gates.
              On activate, cadenceWhich / cadenceDue is Marketing follow-up in the 14-day
              aha window. Proof is a CRM Task — not email, not Marketing Cloud.
              Complete_Activate records people, admin email, or time-off policy — never a card number.
              On Licenses, use nextModuleCopy when present. Time & Attendance is the
              in-product next module; Elite and Payroll stay with a person.
              Seat count / Current MRR: transition to Change my licenses (Get_Licenses_Summary).
              Clarify labels: Current MRR (today), After / quoted monthly, prorated charge
              due at Place order. Keep answers short.
              License amends: Change my licenses (confirmed Place Amend) or the on-page CTA.
              Place and Pay Now / Collect Payment: transition to Purchase. Do not invent a missing Pay Now URL.
              Place in chat is the Purchase topic (confirmed Place action). The summary CTA still works.
              For pricing numbers, hand off to Get a price or quote / Change my licenses topics.
              To persist qualify beats or stamp the self-serve Account, transition to Qualify — this topic only narrates.
        actions:
            Get_Page_Context: @actions.Get_Page_Context
                with messagingSessionId=@variables.RoutableId
                with currentQuoteId=@variables.lastQuoteId
                with currentAccountId=@variables.activeAccountId
                with currentQualifySessionId=@variables.qualifySessionId
                with currentCommitted=@variables.qualifyCommitted
                set @variables.activeAccountId = @outputs.accountId
                set @variables.lastQuoteId = @outputs.quoteId
                set @variables.qualifySessionId = @outputs.qualifySessionId
                set @variables.lastQuoteUrl = @outputs.quoteUrl
                set @variables.qualifyCommitted = @outputs.qualifyCommitted
                set @variables.lastHeadcount = @outputs.headcount
                set @variables.lastStartDate = @outputs.startDate
                set @variables.lastMonthlyTotal = @outputs.monthlyTotalText
            Complete_Activate: @actions.Complete_Activate
                with accountId=@variables.activeAccountId
                with firstName=...
                with lastName=...
                with email=...
                with adminEmail=...
                with timeOffPolicy=...
            go_to_qualify: @utils.transition to @subagent.qualify
            go_to_purchase: @utils.transition to @subagent.purchase
            go_to_change_my_licenses: @utils.transition to @subagent.change_my_licenses

    actions:
        Get_Page_Context:
            description: "Read the buyer's current self-serve wizard beat, employee count, surface, and sales bounce from the Messaging Session. Call before answering any orientation question."
            label: "Get Page Context"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Checking where you are…"
            target: "apex://RLM_BambooAgentGetPageContext"
            inputs:
                messagingSessionId: string
                    description: "Messaging Session Id. Always pass the RoutableId variable."
                    label: "Messaging Session Id"
                    is_required: True
                    is_user_input: False
                currentQuoteId: string
                    description: "lastQuoteId so a blank page does not wipe session."
                    label: "Current Quote Id"
                    is_required: False
                    is_user_input: False
                currentAccountId: string
                    description: "activeAccountId so a blank page does not wipe session."
                    label: "Current Account Id"
                    is_required: False
                    is_user_input: False
                currentQualifySessionId: string
                    description: "qualifySessionId so a blank page does not wipe session."
                    label: "Current qualify session Id"
                    is_required: False
                    is_user_input: False
                currentCommitted: string
                    description: "qualifyCommitted so a blank page does not wipe it."
                    label: "Current committed"
                    is_required: False
                    is_user_input: False
            outputs:
                isSuccess: boolean
                    description: "Success flag."
                    label: "Is Success"
                    is_displayable: False
                    filter_from_agent: False
                errorMessage: string
                    description: "Error if the session could not be read."
                    label: "Error Message"
                    is_displayable: False
                    filter_from_agent: False
                summary: string
                    description: "Page context in one sentence — state this beat to the buyer."
                    label: "Summary"
                    is_displayable: True
                    filter_from_agent: False
                hasContext: boolean
                    description: "False when the buyer opened chat with no wizard context."
                    label: "Has Context"
                    is_displayable: False
                    filter_from_agent: False
                qualifyStep: string
                    description: "Wizard beat 1-5, blank when unknown."
                    label: "Qualify Step"
                    is_displayable: False
                    filter_from_agent: False
                qualifyStepLabel: string
                    description: "Plain-language name of the current beat."
                    label: "Qualify Step Label"
                    is_displayable: False
                    filter_from_agent: False
                bounceType: string
                    description: "size, geo, payroll, elite, or blank."
                    label: "Bounce Type"
                    is_displayable: False
                    filter_from_agent: False
                headcount: string
                    description: "Employee count the buyer entered."
                    label: "Headcount"
                    is_displayable: False
                    filter_from_agent: False
                page: string
                    description: "get-pricing, quote, account, or activate."
                    label: "Page"
                    is_displayable: False
                    filter_from_agent: False
                accountId: string
                    description: "Account Id from pre-chat when present."
                    label: "Account Id"
                    is_displayable: False
                    filter_from_agent: False
                quoteId: string
                    description: "Quote Id when chat opened on the summary."
                    label: "Quote Id"
                    is_displayable: False
                    filter_from_agent: False
                qualifySessionId: string
                    description: "BFF qualify wizard session Id from pre-chat."
                    label: "Qualify session Id"
                    is_displayable: False
                    filter_from_agent: False
                quoteUrl: string
                    description: "Absolute quote summary URL when a Quote Id is known."
                    label: "Quote URL"
                    is_displayable: True
                    filter_from_agent: False
                qualifyCommitted: string
                    description: "true when a Quote Id is present or the session was already committed."
                    label: "Qualify committed"
                    is_displayable: False
                    filter_from_agent: False
                startDate: string
                    description: "Quote or line start YYYY-MM-DD when a Quote Id is known."
                    label: "Start date"
                    is_displayable: False
                    filter_from_agent: False
                monthlyTotal: number
                    description: "Quote TotalPrice when known."
                    label: "Monthly total"
                    is_displayable: False
                    filter_from_agent: False
                    complex_data_type_name: "lightning__numberType"
                monthlyTotalText: string
                    description: "String form of monthlyTotal for lastMonthlyTotal."
                    label: "Monthly total text"
                    is_displayable: False
                    filter_from_agent: False

        Complete_Activate:
            description: "Record Activate people, admin email, or time-off policy. Never a card number."
            label: "Complete Activate"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Updating Activate…"
            target: "apex://RLM_BambooAgentCompleteActivate"
            inputs:
                accountId: string
                    description: "Account Id."
                    label: "Account Id"
                    is_required: False
                    is_user_input: False
                company: string
                    description: "Company name when Account Id is unknown."
                    label: "Company"
                    is_required: False
                    is_user_input: True
                firstName: string
                    description: "Person first name."
                    label: "First name"
                    is_required: False
                    is_user_input: True
                lastName: string
                    description: "Person last name."
                    label: "Last name"
                    is_required: False
                    is_user_input: True
                email: string
                    description: "Person email."
                    label: "Email"
                    is_required: False
                    is_user_input: True
                adminEmail: string
                    description: "Admin email."
                    label: "Admin email"
                    is_required: False
                    is_user_input: True
                timeOffPolicy: string
                    description: "Time-off policy name."
                    label: "Time-off policy"
                    is_required: False
                    is_user_input: True
            outputs:
                isSuccess: boolean
                    description: "True when Activate was updated."
                    label: "Is Success"
                    is_displayable: False
                    filter_from_agent: False
                errorMessage: string
                    description: "Error if Activate failed."
                    label: "Error Message"
                    is_displayable: False
                    filter_from_agent: False
                summary: string
                    description: "Speak this checklist update."
                    label: "Summary"
                    is_displayable: True
                    filter_from_agent: False
                accountId: string
                    description: "Account Id."
                    label: "Account Id"
                    is_displayable: False
                    filter_from_agent: False
                paid: boolean
                    description: "True when payment is recorded."
                    label: "Paid"
                    is_displayable: False
                    filter_from_agent: False
                loginReady: boolean
                    description: "True when a login user exists."
                    label: "Login ready"
                    is_displayable: False
                    filter_from_agent: False
                licensesUrl: string
                    description: "Licenses path."
                    label: "Licenses URL"
                    is_displayable: True
                    filter_from_agent: False
                responseJson: string
                    description: "Raw BFF JSON."
                    label: "Response JSON"
                    is_displayable: False
                    filter_from_agent: True
