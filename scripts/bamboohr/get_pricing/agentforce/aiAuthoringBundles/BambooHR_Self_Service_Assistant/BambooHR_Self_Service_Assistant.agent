subagent change_my_licenses:
    label: "Change my licenses"
    description: "Help existing customers change seats or add modules. Estimate, generate sticky Draft amend Quote, then Place Amend only after confirmation. #DisableURLRedaction#"

    reasoning:
        instructions: ->
            | Help an existing customer change seats or add modules on Licenses.
              Call Get Page Context first so activeAccountId is filled from the page.
              Resolve accountId from Get Page Context, then Get_Licenses_Summary (company name / Account Id).
              Prefer Estimate_Amend for After monthly MRR, then Generate_Or_Update_Amend_Quote for due-today.
              CRITICAL: always pass stickyAmendQuotesJson and stickyModuleQuoteId into Generate_Or_Update_Amend_Quote on edits so the same Draft Quote Id is reused.
              Next module: if page context nextModuleSku is BAMBOO-ADD-TIME (or nextModuleAvailable), suggest Time & Attendance on remaining term.
              After they confirm the amend Quote, call Place_Amend (requires confirmation). Do not call Place_Get_Pricing_Order here.
              Elite and Payroll stay with a person (eliteIsSales / payrollIsSales). Do not Quote BAMBOO-ELITE or BAMBOO-ADD-PAYROLL.
              If nextModuleAvailable is false because Time is already owned, say Time is on and Elite/Payroll stay with a person.
              Explain money carefully:
                - Due today = prorated Quote charge for the change
                - After = new monthly recurring (not ARR)
              Recite due-today before Place_Amend. Never take a card number.
              “Where am I?” / “what page is this” → go_to_help_with_this_page. Speak Licenses & billing plus Account Id from Get Page Context — never a generic “account page”.
        actions:
            Get_Page_Context: @actions.Get_Page_Context
                with messagingSessionId=@variables.RoutableId
                with currentQuoteId=@variables.lastQuoteId
                with currentAccountId=@variables.activeAccountId
                with currentQualifySessionId=@variables.qualifySessionId
                with currentCommitted=@variables.qualifyCommitted
                set @variables.lastQuoteId = @outputs.quoteId
                set @variables.activeAccountId = @outputs.accountId
                set @variables.qualifySessionId = @outputs.qualifySessionId
                set @variables.lastQuoteUrl = @outputs.quoteUrl
                set @variables.qualifyCommitted = @outputs.qualifyCommitted
                set @variables.lastStartDate = @outputs.startDate
                set @variables.lastMonthlyTotal = @outputs.monthlyTotalText
            Get_Licenses_Summary: @actions.Get_Licenses_Summary
                with accountId=@variables.activeAccountId
                with company=...
                set @variables.activeAccountId = @outputs.accountId
            Estimate_Amend: @actions.Estimate_Amend
                with accountId=@variables.activeAccountId
                with newQty=...
                with addonSkusCsv=...
                with startDate=...
            Generate_Or_Update_Amend_Quote: @actions.Generate_Or_Update_Amend_Quote
                with accountId=@variables.activeAccountId
                with newQty=...
                with addonSkusCsv=...
                with startDate=...
                with amendQuotesJson=@variables.stickyAmendQuotesJson
                with moduleQuoteId=@variables.stickyModuleQuoteId
