                    complex_data_type_name: "lightning__integerType"
                responseJson: string
                    description: "Raw BFF JSON."
                    label: "Response JSON"
                    is_displayable: False
                    filter_from_agent: True

        Generate_Or_Update_Amend_Quote:
            description: "Create or update sticky Draft amend Quote(s). Always reuse amendQuotesJson and moduleQuoteId from prior calls. Returns due-today and amend summary URL."
            label: "Generate Or Update Amend Quote"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Updating Draft amend Quote…"
            target: "apex://RLM_BambooAgentGenerateAmendQuote"
            inputs:
                accountId: string
                    description: "Account Id."
                    label: "Account Id"
                    is_required: True
                    is_user_input: True
                newQty: object
