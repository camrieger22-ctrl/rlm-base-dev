                    label: "Plan SKU"
                    is_required: False
                    is_user_input: True
                addonSkusCsv: string
                    description: "Comma-separated add-on SKUs."
                    label: "Add-on SKUs CSV"
                    is_required: False
                    is_user_input: True
                freeTrial: boolean
                    description: "True for free trial estimate."
                    label: "Free trial"
                    is_required: False
                    is_user_input: True
                startDate: string
                    description: "YYYY-MM-DD start date."
                    label: "Start date"
                    is_required: False
                    is_user_input: True
                termMonths: object
                    description: "12, 24, or 36."
                    label: "Term months"
                    is_required: False
                    is_user_input: True
                    complex_data_type_name: "lightning__integerType"
            outputs:
                isSuccess: boolean
                    description: "True when the estimate succeeded."
                    label: "Is Success"
                    is_displayable: False
                    filter_from_agent: False
                errorMessage: string
                    description: "Error if failed."
                    label: "Error Message"
                    is_displayable: False
                    filter_from_agent: False
                summary: string
                    description: "Speak this estimate to the buyer."
                    label: "Summary"
                    is_displayable: True
                    filter_from_agent: False
                currencyCode: string
                    description: "Currency code."
                    label: "Currency"
                    is_displayable: False
                    filter_from_agent: False
                netPepm: number
                    description: "Net PEPM."
                    label: "Net PEPM"
                    is_displayable: False
                    filter_from_agent: False
                    complex_data_type_name: "lightning__numberType"
                monthlyTotal: number
                    description: "Monthly total."
                    label: "Monthly Total"
                    is_displayable: False
                    filter_from_agent: False
                    complex_data_type_name: "lightning__numberType"
                annualTotal: number
