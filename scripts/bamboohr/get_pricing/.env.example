# Copy to .env (gitignored) and `set -a; source .env; set +a` before server.py.
# Quote ALL values — zsh mangles unquoted emails (SF_USERNAME=…@…).
#
# --- Option A: short-lived bearer (from export_cci_token.py) ---
# SF_ACCESS_TOKEN='…'
# SF_INSTANCE_URL='https://your-domain.my.salesforce.com'

# --- Option B: JWT Connected App ---
# SF_CLIENT_ID='…consumer key…'
# SF_USERNAME='camriegermasterdemoorg@demo.com'
# SF_PRIVATE_KEY_PATH='/absolute/path/to/scripts/bamboohr/get_pricing/.secrets/server.key'
# SF_LOGIN_URL='https://your-domain.my.salesforce.com'

# --- Server ---
# PORT='8765'
# BFF_HOST='0.0.0.0'
# BFF_CORS_ORIGIN='*'
# SF_ORG_ALIAS='master-demo'
# DOCGEN_TEMPLATE_NAME='RLM_Bamboo_QuoteProposal'
# Must match Custom Label RLM_Bamboo_Ec_Handoff_Secret (EC → /account handoff)
# EC_HANDOFF_SECRET='bh-ec-handoff-demo-master-2026'

# Public BFF URL used in Pay Now emails (“View licenses & invoices” deep-link)
# BFF_PUBLIC_URL='https://gp.YOURDOMAIN.com'

# --- Stable public URL (named Cloudflare Tunnel — HOSTED.md Path C) ---
# BFF_PUBLIC_URL='https://gp.YOURDOMAIN.com'
# CLOUDFLARE_TUNNEL_NAME='bamboohr-gp'
# CLOUDFLARE_TUNNEL_CONFIG='/absolute/path/to/.secrets/cloudflared.yml'

# --- Agentforce / Messaging embed (Phase 1+) ---
# Preview launcher (no Salesforce Messaging) — default ON if unset.
# AGENT_CHAT_PREVIEW='1'
# Live Messaging for In-App and Web (after Phase 0 org setup):
# AGENT_CHAT_ENABLED='1'
# AGENT_CHAT_ORG_ID='00D……………'
# AGENT_CHAT_DEPLOYMENT_NAME='BambooHR_Self_Service'
# AGENT_CHAT_MESSAGING_URL='https://YOUR-DOMAIN.my.site.com/ESWBambooHR…'
# AGENT_CHAT_SCRT_URL='https://YOUR-DOMAIN.my.salesforce-scrt.com'
# AGENT_CHAT_LANGUAGE='en_US'
# Allow the BFF origin (named tunnel / localhost) on the Messaging Deployment.
