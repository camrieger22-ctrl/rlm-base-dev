// ============================================================================
// KLDPathway — KLDiscovery Nebula ECA → RelOne estimate cascade (API v67 / RLM 262)
// ============================================================================
// Demo scope: KLD-PATH-NEB-R1 only.
//
// Architecture: volume lives on CHILD ATTRIBUTES (Billable_GB / Billable_Hours)
// in PCM. Line Quantity stays 1 (relation cardinality [0..1]).
//
// Editable assumptions: Source_Data_GB, Decompression_Rate_Pct,
// Storage_Expansion_Rate_Pct, ECA_Pct, Active_Review_Pct, Term_Months.
// Derived GB/hours are read-only (configurable = false).
//
// NOTE: Billable_* sync constraints are intentionally omitted for now.
// Syncing child attrs from CML triggered Instant Pricing NPE:
//   productDetails is null
// Re-enable after pricing-procedure overlay + PCM cache refresh are proven.
// ============================================================================

type LineItem;

// Leaf component types (no attrs — PCM Billable_* still on the product).
type Staging : LineItem;
type Nebula_ECA_Hosting : LineItem;
type RelOne_Review : LineItem;
type Project_Management : LineItem;
type Technical_Support : LineItem;

// Matter-estimate attributes on Nebula ECA → RelOne (PC-KLD-PATHWAY).
type KLD_PATH_NEB_R1 : LineItem {
    @(defaultValue = "1000", sequence = 1)
    int Source_Data_GB;

    @(defaultValue = "50", sequence = 2)
    int Decompression_Rate_Pct;

    @(defaultValue = "25", sequence = 3)
    int Storage_Expansion_Rate_Pct;

    @(defaultValue = "70", sequence = 4)
    int ECA_Pct;

    @(defaultValue = "30", sequence = 5)
    int Active_Review_Pct;

    // Source × (1 + decomp%/100), integer truncation
    @(configurable = false, defaultValue = "1500", sequence = 6)
    int Decompression_GB = Source_Data_GB * (100 + Decompression_Rate_Pct) / 100;

    @(configurable = false, defaultValue = "1875", sequence = 7)
    int Storage_Expansion_GB = Decompression_GB * (100 + Storage_Expansion_Rate_Pct) / 100;

    // ECA: round half-up so 1875×70% → 1313 (Standard Average Estimate).
    // Review: truncate so 1875×30% → 562 (ECA + Review = Storage Expansion).
    @(configurable = false, defaultValue = "1313", sequence = 8)
    int ECA_Data_GB = (Storage_Expansion_GB * ECA_Pct + 50) / 100;

    @(configurable = false, defaultValue = "562", sequence = 9)
    int Active_Review_GB = Storage_Expansion_GB * Active_Review_Pct / 100;

    @(configurable = false, defaultValue = "11", sequence = 10)
    int PM_Hours_Per_Month = (Source_Data_GB > 1000) ? 30 : ((Source_Data_GB > 500) ? 11 : ((Source_Data_GB > 200) ? 10 : ((Source_Data_GB > 100) ? 6 : ((Source_Data_GB > 50) ? 4 : ((Source_Data_GB > 0) ? 2 : 0)))));

    @(configurable = false, defaultValue = "7", sequence = 11)
    int Tech_Hours_Per_Month = (Source_Data_GB > 1000) ? 15 : ((Source_Data_GB > 500) ? 7 : ((Source_Data_GB > 200) ? 5 : ((Source_Data_GB > 100) ? 3 : ((Source_Data_GB > 50) ? 2 : ((Source_Data_GB > 0) ? 1 : 0)))));

    @(defaultValue = "12", sequence = 12)
    int Term_Months;

    @(configurable = false, sequence = 13)
    int PM_Total_Hours = PM_Hours_Per_Month * Term_Months;

    @(configurable = false, sequence = 14)
    int Tech_Total_Hours = Tech_Hours_Per_Month * Term_Months;

    // Cardinality [0..1] = at most one line per port (Quantity stays 1 in PCM).
    relation staging_nebr1 : Staging[0..1];
    relation eca_nebr1 : Nebula_ECA_Hosting[0..1];
    relation review_nebr1 : RelOne_Review[0..1];
    relation pm_nebr1 : Project_Management[0..1];
    relation tech_nebr1 : Technical_Support[0..1];
}
