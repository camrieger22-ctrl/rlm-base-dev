    {
      "type": "heading",
      "text": "Implementation notes",
      "level": 2,
      "size_pt": 14,
      "color": "#0B162A",
      "space_after_pt": 6,
      "space_before_pt": 0,
      "underline_rule": {
        "color": "#C83803",
        "thickness_pt": 2.25,
        "space_pt": 0
      }
    },
    {
      "type": "paragraph",
      "text": "\u25aa  Variable tokens render plain strings. Keep descriptions to a single paragraph.",
      "space_after_pt": 6
    },
    {
      "type": "paragraph",
      "text": "\u25aa  Condition tokens require true Boolean values (or a present scalar for AmendCurrentARR self-gating).",
      "space_after_pt": 6
    },
    {
      "type": "paragraph",
      "text": "\u25aa  Do all number and date formatting in the Transform. The template expects display-ready strings.",
      "space_after_pt": 6
    },
    {
      "type": "paragraph",
      "text": "\u25aa  ProductDescription, ServiceTerm, BillingFrequency, OwnerTitle, IF_Includes*, and preformatted delta strings are not in the current org payload and were remapped or dropped.",
      "space_after_pt": 6
    },
    {
      "type": "paragraph",
      "text": "\u25aa  Page breaks that belong to amendment-only content sit inside the AmendCurrentARR gate so standard quotes do not leave a blank page.",
      "space_after_pt": 6
    },
