    {
      "type": "paragraph",
      "text": "This template is built for OmniStudio Document Generation and is wired to RLMQuoteExtractBasic + RLMQuoteTransformBasic \u2014 the same payload as RLM_Bears_Partnership_Deck. Token names below are the org-mapped names.",
      "space_after_pt": 10,
      "line_spacing": 1.3
    },
    {
      "type": "table",
      "columns": 3,
      "header_fill": "#0B162A",
      "header_text_color": "#FFFFFF",
      "text_color": "#333333",
      "body_fill": "#FFFFFF",
      "border": "#CCCCCC",
      "size_pt": 9,
      "header": [
        "Token",
        "Type",
        "Notes"
      ],
      "rows": [
        [
          "AccountName / ContactName / ContactFirstName / ContactTitle",
          "Variable",
          "Customer and contact on the quote."
        ],
        [
          "QuoteNumber / QuoteStartDate / ExpirationDate",
          "Variable",
          "Quote identifiers. ExpirationDate gated when null."
        ],
        [
          "SalesRep / SellerEmail / SellerPhone",
          "Variable",
          "Quote owner as preparer and club signer."
        ],
        [
          "PaymentTerms",
          "Variable",
          "For example Net 30."
        ],
        [
          "Line (+ ProductName, Quantity, NetUnitPrice, NetTotalPrice)",
          "Repeating",
          "Open Line in first pricing cell; close in last cell."
        ],
        [
          "Subtotal / QDiscount / GrandTotal",
          "Variable",
          "Roll-ups. Discount row gated by IF_has_discount."
        ],
        [
          "AmendCurrentARR (gate)",
          "Condition",
          "Scalar present only on amendments."
        ],
        [
          "AmendCurrent* / AmendNetIncrease* / AmendProposed*",
          "Variable",
          "Current / This add / Finalized roll-ups."
        ],
        [
          "AmendAddProduct / AmendProductAmending",
          "Repeating",
          "This-add lines and changed assets."
        ]
