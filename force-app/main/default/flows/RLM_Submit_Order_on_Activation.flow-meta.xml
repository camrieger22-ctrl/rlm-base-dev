<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Direct assetization for orders with no fulfillment scenario. Mutually exclusive with Submit_Order: both paths assetize, so chaining them raised two assetization jobs.</description>
        <name>Assetize_Order</name>
        <label>Assetize Order</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>createOrUpdateAssetFromOrder</actionName>
        <actionType>createOrUpdateAssetFromOrder</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>orderId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>createOrUpdateAssetFromOrder</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <actionCalls>
        <description>DRO path for orders carrying a product with a fulfillment scenario. Decomposition drives assetization, so this branch must not also call Assetize_Order.</description>
        <name>Submit_Order</name>
        <label>Submit Order</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>submitOrder</actionName>
        <actionType>submitOrder</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>orderId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>submitOrder</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Overrides the standard Order-to-Asset flow. Submit_Order and Assetize_Order both trigger assetization, so chaining them raised two AssetizationAsyncJob runs per activation whenever the second trigger landed after the first job had finished, intermittently duplicating assets and applying amendment quantity deltas twice. The two are now mutually exclusive: an order carrying a product with a ProductFulfillmentScenario takes the DRO path through Submit_Order, and everything else assetizes directly through Assetize_Order.</description>
    <assignments>
        <description>Gathers the order's product ids so the fulfillment-scenario test runs as one query rather than one per order item.</description>
        <name>Add_Order_Product_Id</name>
        <label>Add Order Product Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>OrderProductIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Collect_Order_Product_Ids.Product2Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Collect_Order_Product_Ids</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Check if the order has an AppUsageType of RevenueLifecycleManagement before calling Order-to-Asset. Otherwise do nothing.</description>
        <name>IsRevenueLifecycleManagement</name>
        <label>Is RevenueLifecycleManagement</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Record is not RevenueLifecycleManagement</defaultConnectorLabel>
        <rules>
            <name>RecordIsRevenueLifecycleManagement</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_ApplicationUsageAssignment.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Order_Products</targetReference>
            </connector>
            <label>Record is RevenueLifecycleManagement</label>
        </rules>
    </decisions>
    <decisions>
        <description>Sends the order down exactly one assetizing path. A fulfillment scenario on any of the order's products means DRO owns decomposition and the assetization that follows it; otherwise the order assetizes directly.</description>
        <name>DoesOrderRequireFulfillment</name>
        <label>Does Order Require Fulfillment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assetize_Order</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No fulfillment scenario</defaultConnectorLabel>
        <rules>
            <name>OrderRequiresFulfillment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Fulfillment_Scenario.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Submit_Order</targetReference>
            </connector>
            <label>Order requires fulfillment</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>RLM Submit Order on Activation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RLM Submit Order on Activation</label>
    <loops>
        <description>Repeats an action for each order item so its product id joins the collection the fulfillment-scenario lookup filters on.</description>
        <name>Collect_Order_Product_Ids</name>
        <label>Collect Order Product Ids</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Order_Products</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Order_Product_Id</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Fulfillment_Scenario</targetReference>
        </noMoreValuesConnector>
    </loops>
    <overriddenFlow>revenue_o2aflows__o2aFlow</overriddenFlow>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get ApplicationUsageAssignment from the updated order.</description>
        <name>Get_ApplicationUsageAssignment</name>
        <label>Get ApplicationUsageAssignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>IsRevenueLifecycleManagement</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RecordId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>AppUsageType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>RevenueLifecycleManagement</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AppUsageAssignment</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Looks for a fulfillment scenario on any product the order carries. A single match routes the whole order down the DRO path.</description>
        <name>Get_Fulfillment_Scenario</name>
        <label>Get Fulfillment Scenario</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>DoesOrderRequireFulfillment</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ProductId</field>
            <operator>In</operator>
            <value>
                <elementReference>OrderProductIds</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ProductFulfillmentScenario</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Gets the order's items so their product ids can be gathered for the fulfillment-scenario lookup.</description>
        <name>Get_Order_Products</name>
        <label>Get Order Products</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Collect_Order_Product_Ids</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OrderId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OrderItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Activated</stringValue>
            </value>
        </filters>
        <object>Order</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Get_ApplicationUsageAssignment</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <description>Product ids from the order's items, so a single query can test the whole order for a fulfillment scenario.</description>
        <name>OrderProductIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
